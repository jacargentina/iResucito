{
  "name": "@iresucito/native",
  "version": "11.0.8",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "start": "expo start --ios",
    "test": "node node_modules/jest/bin/jest.js --watch",
    "rebuild": "npx expo prebuild --clean; rm -f ios/.xcode.env.local",
    "publish": "npx standard-version -r patch; npm run publish-ios; npm run publish-android; npm run publish-metadata",
    "publish-android": "eas build --non-interactive --platform android --profile production --auto-submit",
    "publish-ios": "eas build --non-interactive --platform ios --profile production --auto-submit",
    "publish-metadata": "node ./scripts/apply-release-notes.js && eas metadata:push --non-interactive",
    "build-ios-local": "mkdir ./temp-build; NODE_ENV=production TMPDIR=./temp-build/ SENTRY_DISABLE_AUTO_UPLOAD=1 EAS_LOCAL_BUILD_SKIP_CLEANUP=1 eas build --local --platform ios",
    "clean": "watchman watch-del-all",
    "generate-screenshots": "node ./scripts/generate-screenshots.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "cd ../.. && yarn build"
  },
  "dependencies": {
    "@codler/react-native-keyboard-aware-scroll-view": "^2.0.1",
